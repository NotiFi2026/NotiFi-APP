# 로컬 백엔드(NotiFi-Server) 기준 — 포트 8080, context-path 없음, 외부 API base = /api/v1.
# 호스트는 실행 대상에 맞게 바꿀 것:
#   Android 에뮬레이터  http://10.0.2.2:8080/api/v1   ← 호스트 PC를 가리키는 예약 주소
#   Expo Web / 같은 PC  http://localhost:8080/api/v1
#   실기기(같은 공유기)  http://<PC의 사설 IP>:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 백엔드 없이 인증 화면을 확인할 때만 true. 켜면 화면에 MOCK 배지가 뜬다.
#   비밀번호 "wrong" → INVALID_CREDENTIALS, 이메일 taken@notifi.app → EMAIL_ALREADY_EXISTS
# 서버가 붙으면 이 줄과 src/api/mock/ 을 함께 지운다.
EXPO_PUBLIC_USE_MOCK_AUTH=false

# 백엔드 없이 홈(노인 목록)을 확인할 때만 true. 켜면 화면에 MOCK 배지가 뜬다.
#   0명/1명/N명 분기는 src/api/mock/careTargetsMock.ts의 MOCK_SCENARIO로 전환.
# care-targets API가 붙으면 이 줄과 목 파일을 함께 지운다.
EXPO_PUBLIC_USE_MOCK_CARE_TARGETS=false

# 리플레이 클립(S3)만 목으로 볼 때 true. 켜면 화면에 MOCK 배지가 뜬다.
#   서버 S3는 구현됐지만 AI가 I5로 클립을 적재한 적이 없어, 실이벤트를 보면서
#   리플레이만 목으로 돌려야 하는 기간이 있어 플래그를 따로 뒀다.
#   목 클립은 모델 모션 뱅크에서 추출한 실제 낙상 궤적이다 (src/api/mock/fixtures/).
# AI가 클립 적재를 시작하면 이 줄과 목 파일·픽스처를 함께 지운다.
EXPO_PUBLIC_USE_MOCK_POSE_CLIP=false

# FCM 원격 푸시는 Expo Go에서 불가(SDK 53+) — dev build 필요:
#   1) docs/firebase-setup.md 절차로 google-services.json을 프로젝트 루트에 배치
#   2) npx expo run:android (또는 EAS dev build)
