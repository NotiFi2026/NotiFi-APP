# 로컬 백엔드(NotiFi-Server) 기준. 실기기(Expo Go)에서 테스트 시 localhost 대신 PC의 LAN IP를 사용할 것.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# FCM 원격 푸시는 Expo Go에서 불가(SDK 53+) — dev build 필요:
#   1) docs/firebase-setup.md 절차로 google-services.json을 프로젝트 루트에 배치
#   2) npx expo run:android (또는 EAS dev build)
