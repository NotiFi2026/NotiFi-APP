{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK_AUTH": "true"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      }
    }
  }
}
